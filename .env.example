# Readhouse configuration. Copy to .env and adjust.

# AllTalk v2 server as seen from this machine. Readhouse proxies it, so AllTalk itself does
# not need to be reachable from your phone.
ALLTALK_URL=http://127.0.0.1:7851

# Where the library database and generated audio live.
DATA_DIR=data

# Optional: require a passcode to open Readhouse from other devices (6+ characters).
# ACCESS_PASSCODE=

# Longest text per AllTalk request (100-2000). Shorter starts playback sooner.
SEGMENT_MAX_CHARS=500

# Disk space for generated audio before the least recently played is removed.
AUDIO_CACHE_MAX_MB=2048

# Largest book file that can be imported.
UPLOAD_MAX_MB=64
